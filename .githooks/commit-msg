#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit message file is required}"
first_line="$(sed -n '1p' "$msg_file")"

if ! printf "%s" "$first_line" | rg -q '^(feat|fix|docs|chore|refactor|test|ops|data)(\([a-z0-9._-]+\))?: .+'; then
  printf "Commit message must use Conventional Commits, got: %s\n" "$first_line" >&2
  exit 1
fi
