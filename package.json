{
  "name": "browser-bi-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages-preview": "vite preview --host 127.0.0.1",
    "preview": "vite preview",
    "smoke": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.83",
    "@observablehq/plot": "^0.6.17",
    "@tanstack/react-query": "^5.100.9",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.14.0",
    "papaparse": "^5.5.3",
    "plotly.js-dist-min": "^3.5.1",
    "pyodide": "^0.29.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
